---
export interface Props {
  /** 'full' = marketing 3-column; 'blog' = i18n-friendly shorter columns */
  variant?: 'full' | 'blog';
}

const { variant = 'full' } = Astro.props;
---

{
  variant === 'blog' ? (
    <footer class="footer">
      <div class="container footer-content">
        <div class="footer-brand">
          <a href="/" class="logo">
            <img src="/logo-icon-w.png" alt="SmokingTracker Logo" class="logo-img" width="32" height="32" />
            <span class="logo-text">SmokingTracker</span>
          </a>
          <p data-i18n="footer.desc">
            Real-time cannabis use data between sessions — for outpatient treatment programs and the clients they serve.
          </p>
        </div>
        <div class="footer-links">
          <div class="link-group">
            <h4 data-i18n="footer.product">Product</h4>
            <a href="/features.html" data-i18n="nav.features">Features</a>
            <a href="/#how-it-works" data-i18n="nav.howItWorks">How It Works</a>
            <a href="/pricing.html" data-i18n="nav.pricing">Pricing</a>
            <a href="/faq.html" data-i18n="nav.faq">FAQ</a>
            <a href="/about.html" data-i18n="nav.about">About</a>
            <a href="/knowledge-base.html" data-i18n="nav.blog">Blog</a>
          </div>
          <div class="link-group">
            <h4 data-i18n="footer.legal">Legal</h4>
            <a href="/privacy.html" data-i18n="footer.privacy">Privacy Policy</a>
            <a href="/terms.html" data-i18n="footer.terms">Terms of Service</a>
            <a href="/dpa.html" data-i18n="footer.dpa">Data Processing Agreement</a>
            <a href="/security.html" data-i18n="footer.security">Security</a>
          </div>
          <div class="link-group">
            <h4 data-i18n="footer.connect">Connect</h4>
            <a href="mailto:support@smokingtracker.com" data-i18n="footer.contact">Contact</a>
          </div>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>&copy; 2026 SmokingTracker. All rights reserved.</p>
      </div>
    </footer>
  ) : (
    <footer class="footer">
      <div class="container footer-content">
        <div class="footer-brand">
          <a href="/" class="logo">
            <img src="/logo-icon.webp" alt="SmokingTracker" class="logo-img" width="28" height="28" />
            <span class="logo-text">SmokingTracker</span>
          </a>
          <p>Real-time cannabis use data between sessions — for outpatient treatment programs and the clients they serve.</p>
        </div>
        <div class="footer-links">
          <div class="link-group">
            <h4>Features</h4>
            <a href="/ema-logging.html">EMA Logging</a>
            <a href="/practitioner-dashboard.html">Practitioner Dashboard</a>
            <a href="/clinical-reports.html">Clinical Reports</a>
            <a href="/privacy-compliance.html">Privacy &amp; Compliance</a>
            <a href="/measurement-based-care.html">Measurement-Based Care</a>
            <a href="/cannabis-cognitive-fog.html">Cannabis &amp; Memory</a>
          </div>
          <div class="link-group">
            <h4>Product</h4>
            <a href="/features.html">All Features</a>
            <a href="/for-clinicians.html">For Clinicians</a>
            <a href="/for-individuals.html">For Individuals</a>
            <a href="/pricing.html">Pricing</a>
            <a href="/about.html">About</a>
            <a href="/knowledge-base.html">Blog</a>
          </div>
          <div class="link-group">
            <h4>Legal</h4>
            <a href="/privacy.html">Privacy Policy</a>
            <a href="/terms.html">Terms of Service</a>
            <a href="/dpa.html">Data Processing Agreement</a>
            <a href="/security.html">Security</a>
            <a href="mailto:support@smokingtracker.com">Contact</a>
          </div>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>&copy; 2026 SmokingTracker &nbsp;&middot;&nbsp; Built for outpatient treatment. Privacy by Design.</p>
      </div>
    </footer>
  )
}
