---
import MinimalLayout from '../layouts/MinimalLayout.astro';

const title = 'SmokingTracker — Cannabis Habit Tracking for Individuals & Treatment Centers';
const description =
  'SmokingTracker helps individuals understand their cannabis habits and gives treatment centers real-time client data between sessions. Who are you?';

const panels = [
  {
    href: '/for-individuals.html',
    side: 'left',
    eyebrow: 'For you',
    heading: 'I want to track\nmy own habits',
    body: 'Understand your use, spot triggers, and set goals with complete privacy.',
    sub: 'Free forever · No account needed to start',
    cta: 'Get Started Free',
    bgImage: '/images/en_tracker_statistics.webp',
    icon: 'individual',
  },
  {
    href: '/for-clinicians.html',
    side: 'right',
    eyebrow: 'For clinicians',
    heading: 'I work with\nclients',
    body: 'Replace recall bias with real-time EMA data. Traffic-light dashboards and clinical reports.',
    sub: 'Free until Oct 2026 · GDPR & HIPAA ready',
    cta: 'View Clinical Solutions',
    bgImage: '/images/en_behandler_patient_list.webp',
    icon: 'clinician',
  },
];
---

<MinimalLayout title={title} description={description} canonicalPath="/">
  <div slot="head" style="display:contents">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --green:      #10b981;
        --green-dark: #065f46;
        --green-mid:  #34d399;
        --bg:         #020c07;
        --bg-panel:   #041009;
        --border:     rgba(255,255,255,0.07);
        --border-g:   rgba(16,185,129,0.2);
        --dim:        rgba(255,255,255,0.4);
        --mid:        rgba(255,255,255,0.65);
      }

      html, body {
        height: 100%;
        background: var(--bg);
        color: #fff;
        font-family: 'Outfit', sans-serif;
        overflow: hidden;
      }

      /* ── LOGO ── */
      .logo {
        position: fixed;
        top: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 200;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        color: #fff;
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: -0.01em;
        white-space: nowrap;
        padding: 0.45rem 1rem 0.45rem 0.7rem;
        border-radius: 100px;
        background: rgba(2,12,7,0.7);
        border: 1px solid var(--border);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        animation: logoIn 0.7s ease both 0.1s;
      }
      .logo img { display: block; border-radius: 4px; }

      /* ── LAYOUT ── */
      .chooser {
        display: flex;
        height: 100vh;
        width: 100vw;
        position: relative;
        animation: fadeIn 0.5s ease both 0.05s;
      }

      /* ── PANEL ── */
      .panel {
        flex: 1;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 3rem 3rem 3rem;
        text-decoration: none;
        color: #fff;
        overflow: hidden;
        transition: flex 0.5s cubic-bezier(0.4,0,0.2,1);
        cursor: pointer;
      }

      .chooser:has(.panel:hover) .panel      { flex: 0.72; }
      .chooser:has(.panel:hover) .panel:hover { flex: 1.28; }

      /* Photo bg */
      .panel-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center top;
        opacity: 0.12;
        filter: grayscale(0.5) brightness(0.5);
        transition: opacity 0.7s ease, filter 0.7s ease, transform 0.9s ease;
        z-index: 0;
      }
      .panel:hover .panel-bg {
        opacity: 0.22;
        filter: grayscale(0) brightness(0.55);
        transform: scale(1.04);
      }

      /* Dark gradient from bottom */
      .panel-grad {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to top,
          rgba(2,12,7,1)    0%,
          rgba(2,12,7,0.88) 38%,
          rgba(2,12,7,0.4)  65%,
          transparent       100%
        );
        z-index: 1;
      }

      /* Green bloom on hover */
      .panel-bloom {
        position: absolute;
        bottom: -10%;
        left: 50%;
        transform: translateX(-50%);
        width: 70%;
        height: 50%;
        background: radial-gradient(ellipse, rgba(16,185,129,0.13) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.55s ease;
        z-index: 1;
      }
      .panel:hover .panel-bloom { opacity: 1; }

      /* Top line accent */
      .panel::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--green), transparent);
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: 5;
      }
      .panel:hover::after { opacity: 1; }

      /* Content */
      .panel-content {
        position: relative;
        z-index: 2;
        max-width: 380px;
      }

      /* Eyebrow */
      .eyebrow {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--green);
        margin-bottom: 1.75rem;
      }
      .eyebrow-dot {
        width: 6px; height: 6px;
        border-radius: 50%;
        background: var(--green);
        flex-shrink: 0;
        animation: dotpulse 2.8s ease-in-out infinite;
      }

      /* Icon */
      .icon-wrap {
        width: 64px; height: 64px;
        border-radius: 16px;
        border: 1px solid var(--border-g);
        background: rgba(16,185,129,0.06);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--green);
        margin-bottom: 1.5rem;
        transition: background 0.35s ease, border-color 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
      }
      .panel.left:hover  .icon-wrap { transform: translateY(-5px) rotate(5deg); }
      .panel.right:hover .icon-wrap { transform: translateY(-5px) rotate(-5deg); }
      .panel:hover .icon-wrap {
        background: var(--green);
        color: #fff;
        border-color: var(--green);
        box-shadow: 0 8px 32px rgba(16,185,129,0.3);
      }

      /* Heading */
      .heading {
        font-size: clamp(1.9rem, 3.2vw, 2.8rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: #fff;
        margin-bottom: 1.1rem;
        white-space: pre-line;
      }

      /* Body */
      .body-text {
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.6;
        color: var(--mid);
        margin-bottom: 0.6rem;
        transition: color 0.3s ease;
      }
      .panel:hover .body-text { color: rgba(255,255,255,0.82); }

      /* Sub-note */
      .sub-note {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--dim);
        margin-bottom: 2rem;
        letter-spacing: 0.01em;
      }

      /* CTA */
      .cta {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--green);
        transition: gap 0.3s ease, color 0.3s ease;
      }
      .panel:hover .cta {
        gap: 1rem;
        color: var(--green-mid);
      }
      .cta-icon {
        width: 34px; height: 34px;
        border-radius: 50%;
        border: 1.5px solid rgba(16,185,129,0.35);
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
      }
      .panel:hover .cta-icon {
        background: var(--green);
        border-color: var(--green);
        transform: rotate(-45deg);
      }

      /* ── DIVIDER ── */
      .divider {
        position: absolute;
        top: 0; bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 1px;
        background: linear-gradient(to bottom, transparent 5%, var(--border) 25%, var(--border) 75%, transparent 95%);
        z-index: 10;
        pointer-events: none;
      }
      .divider-center {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        z-index: 11;
        width: 52px; height: 52px;
        border-radius: 50%;
        background: var(--bg);
        border: 1px solid var(--border);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 0 0 6px var(--bg), 0 0 24px rgba(16,185,129,0.12);
      }
      .divider-center img { display: block; }

      /* ── HINT ── */
      .hint {
        position: fixed;
        bottom: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 50;
        font-size: 0.65rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.2);
        animation: hintIn 1s ease both 1.2s;
        pointer-events: none;
        white-space: nowrap;
      }

      /* ── KEYFRAMES ── */
      @keyframes logoIn {
        from { opacity:0; transform: translateX(-50%) translateY(-8px); }
        to   { opacity:1; transform: translateX(-50%) translateY(0); }
      }
      @keyframes fadeIn {
        from { opacity:0; }
        to   { opacity:1; }
      }
      @keyframes hintIn {
        from { opacity:0; transform: translateX(-50%) translateY(6px); }
        to   { opacity:1; transform: translateX(-50%) translateY(0); }
      }
      @keyframes dotpulse {
        0%, 100% { opacity:1; transform: scale(1); }
        50%       { opacity:0.3; transform: scale(0.6); }
      }

      /* ── MOBILE ── */
      @media (max-width: 800px) {
        html, body { overflow-y: auto; }
        .chooser {
          flex-direction: column;
          height: auto;
          min-height: 100dvh;
        }
        .chooser:has(.panel:hover) .panel,
        .chooser:has(.panel:hover) .panel:hover { flex: 1; }
        .panel { padding: 3rem 1.75rem 2.5rem; min-height: 50dvh; }
        .divider, .divider-center { display: none; }
        .panel::after { display: none; }
        .hint { display: none; }
        .logo { font-size: 1rem; }
      }
    </style>
  </div>

  <!-- Logo -->
  <a href="/" class="logo">
    <img src="/logo-icon.png" alt="SmokingTracker" width="26" height="26" />
    SmokingTracker
  </a>

  <!-- Chooser -->
  <div class="chooser">
    {panels.map((p) => (
      <a href={p.href} class={`panel ${p.side}`}>
        <div class="panel-bg" style={`background-image:url('${p.bgImage}')`}></div>
        <div class="panel-grad"></div>
        <div class="panel-bloom"></div>

        <div class="panel-content">
          <div class="eyebrow">
            <span class="eyebrow-dot"></span>
            {p.eyebrow}
          </div>

          <div class="icon-wrap">
            {p.icon === 'individual' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            )}
            {p.icon === 'clinician' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            )}
          </div>

          <h2 class="heading">{p.heading}</h2>
          <p class="body-text">{p.body}</p>
          <p class="sub-note">{p.sub}</p>

          <span class="cta">
            {p.cta}
            <span class="cta-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </span>
        </div>
      </a>
    ))}

    <div class="divider"></div>
    <div class="divider-center">
      <img src="/logo-icon.png" alt="" width="32" height="32" />
    </div>
  </div>

  <p class="hint">Choose your path</p>
</MinimalLayout>