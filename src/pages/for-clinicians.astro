  <script slot="scripts" define:vars={{ captions: carouselSlides.map((slide) => slide.caption) }}>
    (() => {
      const carousel = document.getElementById('hero-carousel');
      if (!carousel) return;
      const slides = Array.from(carousel.querySelectorAll('.hero-carousel-slide'));
      const dots = Array.from(carousel.querySelectorAll('.hero-carousel-dot'));
      const caption = carousel.querySelector('.hero-carousel-caption');
      const prevBtn = carousel.querySelector('.hero-carousel-prev');
      const nextBtn = carousel.querySelector('.hero-carousel-next');
      let current = 0;
      let timer;

      function goTo(n) {
        slides[current]?.classList.remove('active');
        dots[current]?.classList.remove('active');
        current = (n + slides.length) % slides.length;
        slides[current]?.classList.add('active');
        dots[current]?.classList.add('active');
        if (caption) caption.textContent = captions[current];
      }

      function start() {
        timer = window.setInterval(() => goTo(current + 1), 5000);
      }

      function stop() {
        window.clearInterval(timer);
      }

      dots.forEach((dot, index) => dot.addEventListener('click', () => {
        stop();
        goTo(index);
        start();
      }));
      prevBtn?.addEventListener('click', () => {
        stop();
        goTo(current - 1);
        start();
      });
      nextBtn?.addEventListener('click', () => {
        stop();
        goTo(current + 1);
        start();
      });
      carousel.addEventListener('mouseenter', stop);
      carousel.addEventListener('mouseleave', start);
      start();
    })();

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));

    (() => {
      const demoImages = [
        '/homescreenview.png',
        '/images/en_tracker_achievements.png',
        '/images/en_tracker_log_session_modal.webp',
        '/images/en_tracker_home_calendar.webp',
      ];
      const clickCoordinates = [
        { top: '71%', left: '85%' },
        { top: '95%', left: '85%' },
        { top: '91%', left: '50%' },
      ];

      let demoIndex = 0;
      const screen = document.getElementById('demo-screen');
      const hotspot = document.getElementById('demo-hotspot');
      const steps = document.querySelectorAll('.demo-wrapper .step');

      if (!screen || !hotspot) return;

      function updateDemoUI() {
        screen.style.backgroundImage = `url('${demoImages[demoIndex]}')`;

        steps.forEach((step, index) => {
          step.classList.remove('active', 'completed');
          if (demoIndex === index) {
            step.classList.add('active');
          } else if (demoIndex > index) {
            step.classList.add('completed');
          }
        });

        if (demoIndex < 3) {
          hotspot.classList.remove('hidden');
          hotspot.style.top = clickCoordinates[demoIndex].top;
          hotspot.style.left = clickCoordinates[demoIndex].left;
        } else {
          hotspot.classList.add('hidden');
        }
      }

      screen.addEventListener('click', () => {
        demoIndex += 1;
        if (demoIndex >= demoImages.length) demoIndex = 0;
        updateDemoUI();
      });

      steps.forEach((step, index) => {
        step.addEventListener('click', () => {
          demoIndex = index;
          updateDemoUI();
        });
      });

      updateDemoUI();
    })();

    window.addEventListener('load', () => {
      document.documentElement.style.visibility = 'visible';
    });
  </script>
