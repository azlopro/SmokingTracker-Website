---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageSeo } from '../lib/pageSeo';

const { title, description, ogTitle, ogDescription, ogImage } = getPageSeo('features');

const featureCards = [
  {
    icon: 'activity',
    eyebrow: 'Client app',
    title: 'EMA Logging',
    body: 'Three-tap session capture in real time — method, amount, mood, trigger. No recall bias. No missing data.',
    href: '/ema-logging.html',
  },
  {
    icon: 'grid',
    eyebrow: 'Clinician tools',
    title: 'Practitioner Dashboard',
    body: 'Traffic-light triage, trigger rankings, and use-trend analytics for your entire caseload on one screen.',
    href: '/practitioner-dashboard.html',
  },
  {
    icon: 'file-text',
    eyebrow: 'Documentation',
    title: 'Clinical Reports',
    body: 'One-click PDF exports with trend charts, annotations, and trigger analysis — formatted for EHR or referral.',
    href: '/clinical-reports.html',
  },
  {
    icon: 'pulse',
    eyebrow: 'Evidence base',
    title: 'Measurement-Based Care',
    body: 'How systematic real-time data translates into better session decisions and improved treatment outcomes.',
    href: '/measurement-based-care.html',
  },
  {
    icon: 'lock',
    eyebrow: 'Compliance',
    title: 'Privacy & Compliance',
    body: 'HIPAA, GDPR, and 42 CFR Part 2 — simultaneously. Client-controlled consent baked into the data model.',
    href: '/privacy-compliance.html',
  },
  {
    icon: 'zap',
    eyebrow: 'Clinical context',
    title: 'Cannabis & Memory',
    body: "Why regular cannabis use makes recall unreliable — and why EMA is the only clinical solution that works with it.",
    href: '/cannabis-cognitive-fog.html',
  },
];

const accordionSections = [
  {
    id: 'client-logging',
    title: 'Client-Side Logging',
    items: [
      ['Three-tap session logging', 'Quick and accurate capture.'],
      ['Mood & craving tracking', 'Tied to every use event.'],
      ['Fast-use warnings', 'Real-time behavioral feedback.'],
      ['Heatmap calendar', 'Visual overview of use patterns.'],
      ['Goal configuration', 'Reduce, Quit, or Awareness modes.'],
    ],
  },
  {
    id: 'practitioner',
    title: 'Practitioner Dashboard',
    items: [
      ['Multi-client caseload', 'All clients on one screen.'],
      ['Trigger rankings', 'Identify high-risk social contexts.'],
      ['Method analytics', 'Flower, vape, and edible split.'],
      ['Clinical annotations', 'Direct session notes.'],
      ['Easy PDF reports', 'EHR-ready documentation, printed from your browser.'],
    ],
  },
  {
    id: 'engagement',
    title: 'Engagement & Alliance',
    items: [
      ['Achievement badges', 'Positive reinforcement.'],
      ['Money saved calculator', 'Rational motivations.'],
      ['Time-since-last-smoke', 'Visual progress.'],
      ['Urge Surfing exercises', 'Acute craving support.'],
      ['Implemental intentions', 'Define smoke-free hours with frictionless override prompts.'],
    ],
  },
  {
    id: 'privacy',
    title: 'Privacy & Compliance',
    items: [
      ['HIPAA Compliant', 'BAA available.'],
      ['GDPR DPA', 'Standard in all contracts.'],
      ['42 CFR Part 2', 'Specialized for SUD.'],
      ['Revocable consent', 'Clients control their data.'],
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath="/features.html"
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  twitterImage={ogImage}
  activeNav="features"
  navVariant="marketing"
  navTheme="light"
  footerVariant="full"
  bodyClass="light-theme"
  showCta={true}
  includeMainJs={false}
  hideUntilLoad={true}
>
  <div slot="head">
    <style is:global>
      .feature-hero { background: var(--green); position: relative; overflow: hidden; padding: 4rem 2.5rem 0; text-align: center; }
      .feature-hero::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 28px 28px; pointer-events: none; }
      .feature-hero-inner { max-width: 760px; margin: 0 auto; position: relative; padding-bottom: 3.5rem; }
      .feature-hero h1 { font-size: clamp(2rem, 3.8vw, 3rem); font-weight: 800; color: white; letter-spacing: -0.6px; line-height: 1.15; margin-bottom: 1.25rem; }
      .feature-hero-sub { font-size: 1.1rem; color: rgba(255,255,255,0.82); line-height: 1.7; margin-bottom: 2rem; }
      .feature-hero-btns { display: flex; gap: 0.85rem; justify-content: center; flex-wrap: wrap; }
      .hero-wave { display: block; width: 100%; }

      /* Feature hub cards */
      .hub-cards-section { padding: 5.5rem 2.5rem; background: #ffffff; }
      .hub-cards-grid {
        max-width: 1080px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
      }
      .hub-card {
        background: #ffffff;
        border: 1px solid #e6ede8;
        border-radius: 16px;
        padding: 2rem;
        text-decoration: none;
        color: inherit;
        transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        box-shadow: var(--shadow-card);
      }
      .hub-card:hover { transform: translateY(-3px); box-shadow: 0 8px 28px rgba(6,95,70,0.09); border-color: #c8ddd0; }
      .hub-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #eef8f2;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.35rem;
      }
      .hub-card-icon svg { stroke: var(--green-hero); fill: none; stroke-linecap: round; stroke-linejoin: round; }
      .hub-card-eyebrow { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--green-hero); }
      .hub-card-title { font-size: 1.05rem; font-weight: 700; color: #0f1e14; line-height: 1.25; }
      .hub-card-body { font-size: 13.5px; color: #3d4f45; line-height: 1.65; flex: 1; }
      .hub-card-link { font-size: 13px; font-weight: 600; color: var(--green-hero); display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.5rem; }
      .hub-card:hover .hub-card-link { gap: 0.55rem; }

      /* Accordion — light theme */
      .hub-accordion-section { padding: 5.5rem 2.5rem; background: #f7faf8; border-top: 1px solid #e6ede8; }
      .hub-accordion-inner { max-width: 860px; margin: 0 auto; }
      .hub-accordion-item {
        background: #ffffff;
        border: 1px solid #e6ede8;
        border-radius: 14px;
        margin-bottom: 0.75rem;
        overflow: hidden;
        transition: border-color 0.2s;
      }
      .hub-accordion-item:hover { border-color: #c8ddd0; }
      .hub-accordion-item.active { border-color: #aed4bc; }
      .hub-accordion-trigger {
        width: 100%;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        background: none;
        border: none;
        color: #0f1e14;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        text-align: left;
        font-family: var(--font-family);
        transition: color 0.15s;
      }
      .hub-accordion-trigger:hover { color: var(--green-hero); }
      .hub-accordion-item.active .hub-accordion-trigger { color: var(--green-hero); }
      .hub-accordion-chevron { flex-shrink: 0; transition: transform 0.25s ease; color: #9ca3af; }
      .hub-accordion-item.active .hub-accordion-chevron { transform: rotate(180deg); color: var(--green-hero); }
      .hub-accordion-content { overflow: hidden; max-height: 0; transition: max-height 0.35s cubic-bezier(0.4,0,0.2,1); }
      .hub-accordion-item.active .hub-accordion-content { max-height: 600px; }
      .hub-accordion-body { padding: 0 1.5rem 1.5rem; }
      .hub-feature-list {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 0.65rem;
      }
      .hub-feature-item {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-size: 0.9rem;
        color: #3d4f45;
        line-height: 1.5;
      }
      .hub-feature-dot { width: 6px; height: 6px; background: var(--green); border-radius: 50%; flex-shrink: 0; margin-top: 0.44em; }
      .hub-feature-item strong { color: #0f1e14; font-weight: 600; }

      @media (max-width: 860px) { .hub-cards-grid { grid-template-columns: repeat(2, 1fr); } }
      @media (max-width: 560px) {
        .hub-cards-grid { grid-template-columns: 1fr; }
        .hub-cards-section, .hub-accordion-section { padding: 3.5rem 1.25rem; }
      }
    </style>
  </div>

  <section class="feature-hero">
    <div class="feature-hero-inner">
      <div class="feature-eyebrow feature-eyebrow--hero">Platform Overview</div>
      <h1>Built for the reality of cannabis treatment.</h1>
      <p class="feature-hero-sub">
        SmokingTracker combines frictionless client-side logging with clinical intelligence to solve the recall
        problem in CUD treatment.
      </p>
      <div class="feature-hero-btns">
        <a href="/trial.html" class="btn-orange-lg">Start Free</a>
        <a href="/for-clinicians.html" class="btn-ghost">See Full Platform</a>
      </div>
    </div>
    <svg class="hero-wave" viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,30 C360,70 1080,-10 1440,30 L1440,60 L0,60 Z" fill="white"></path>
    </svg>
  </section>

  <section class="hub-cards-section">
    <div class="section-center reveal" style="margin-bottom:3rem;">
      <div class="section-eyebrow">What's included</div>
      <h2 class="section-title-lg">Six deep-dive feature areas</h2>
      <p class="section-sub">Each links to a full breakdown of the clinical rationale, workflow, and data behind that part of the platform.</p>
    </div>
    <div class="hub-cards-grid">
      {featureCards.map((card) => (
        <a class="hub-card reveal" href={card.href}>
          <div class="hub-card-icon">
            {card.icon === 'activity' && (
              <svg width="22" height="22" viewBox="0 0 24 24" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
            )}
            {card.icon === 'grid' && (
              <svg width="22" height="22" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg>
            )}
            {card.icon === 'file-text' && (
              <svg width="22" height="22" viewBox="0 0 24 24" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            )}
            {card.icon === 'pulse' && (
              <svg width="22" height="22" viewBox="0 0 24 24" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
            )}
            {card.icon === 'lock' && (
              <svg width="22" height="22" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            )}
            {card.icon === 'zap' && (
              <svg width="22" height="22" viewBox="0 0 24 24" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            )}
          </div>
          <div class="hub-card-eyebrow">{card.eyebrow}</div>
          <div class="hub-card-title">{card.title}</div>
          <div class="hub-card-body">{card.body}</div>
          <div class="hub-card-link">
            Explore
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="hub-accordion-section">
    <div class="hub-accordion-inner">
      <div class="section-center reveal" style="margin-bottom:3rem;">
        <div class="section-eyebrow">Complete directory</div>
        <h2 class="section-title-lg">Every feature, explained.</h2>
      </div>
      <div>
        {accordionSections.map((section, index) => {
          const isOpen = index === 0;
          const triggerId = `acc-trigger-${section.id}`;
          const panelId = `acc-panel-${section.id}`;
          return (
            <div class:list={['hub-accordion-item', { active: isOpen }]}>
              <button
                class="hub-accordion-trigger"
                aria-expanded={isOpen ? 'true' : 'false'}
                aria-controls={panelId}
                id={triggerId}
                type="button"
              >
                <span>{section.title}</span>
                <svg class="hub-accordion-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="hub-accordion-content" id={panelId} role="region" aria-labelledby={triggerId}>
                <div class="hub-accordion-body">
                  <ul class="hub-feature-list">
                    {section.items.map(([label, text]) => (
                      <li class="hub-feature-item">
                        <span class="hub-feature-dot" aria-hidden="true"></span>
                        <span><strong>{label}</strong> — {text}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <script slot="scripts" is:inline>
    document.querySelectorAll('.hub-accordion-trigger').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.parentElement;
        const isActive = item?.classList.contains('active');
        document.querySelectorAll('.hub-accordion-item').forEach((el) => {
          el.classList.remove('active');
          el.querySelector('.hub-accordion-trigger')?.setAttribute('aria-expanded', 'false');
        });
        if (!isActive && item) {
          item.classList.add('active');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>
</BaseLayout>
