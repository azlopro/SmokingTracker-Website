---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageSeo } from '../lib/pageSeo';

const { title, description, ogTitle, ogDescription } = getPageSeo('for-individuals');

const heroSlides = [
  {
    src: '/images/en_tracker_log_session_modal.webp',
    alt: 'SmokingTracker log session screen',
    width: 390,
    height: 844,
    priority: true,
  },
  {
    src: '/images/en_tracker_home_calendar.webp',
    alt: 'SmokingTracker calendar overview',
    width: 390,
    height: 844,
  },
  {
    src: '/images/en_tracker_statistics.webp',
    alt: 'SmokingTracker statistics overview',
    width: 390,
    height: 844,
  },
];

const pillars = [
  {
    label: 'Three taps',
    title: 'Log in the moment, not from memory',
    body: 'Most people wildly underestimate how much they smoke because memory fills in the gaps. Logging in real time gives you numbers you can actually trust.',
  },
  {
    label: 'Private first',
    title: 'No one sees this but you',
    body: 'Your logs are private by default and stay that way. SmokingTracker never sells or shares your data. You are in total control.',
  },
  {
    label: 'See patterns',
    title: "Spot what you'd never notice alone",
    body: "Frequency, time of day, mood, triggers — they accumulate into a picture week over week that you'd never piece together from memory alone.",
  },
];

const loggingBullets = [
  'Three required taps — nothing more',
  'Optional: mood, craving level, location, and notes',
  "Fast-use warning if you've logged recently",
];

const demoSteps = [
  { title: 'Open Tracker', body: 'Tap your home link' },
  { title: 'Quick Log', body: 'Tap Method & Amount' },
  { title: 'Confirm', body: 'Tap Save Session' },
];

const insightBullets = [
  'Streaks and smoke-free milestones',
  'Reduction achievements as your average drops',
  'Judgement-free personal goal tracking',
];

const fanImages = [
  { src: '/images/en_tracker_achievements.png', alt: 'SmokingTracker achievements' },
  { src: '/images/en_tracker_statistics.webp', alt: 'SmokingTracker statistics' },
  { src: '/images/en_tracker_home_calendar.webp', alt: 'SmokingTracker calendar' },
  { src: '/images/en_tracker_statistics.webp', alt: 'SmokingTracker trend insights' },
  { src: '/images/en_tracker_achievements.png', alt: 'SmokingTracker milestones' },
];

const pricingFeatures = [
  'Full overview of your smoking habits',
  'Insights into frequency, timing & triggers',
  'Private by design — data stays with you',
];
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath="/for-individuals.html"
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  activeNav="for-individuals"
  navVariant="marketing"
  navTheme="dark"
  navSignInHref="https://app.smokingtracker.com"
  navCtaHref="https://www.smokingtracker.com/individual-signup.html"
  footerVariant="full"
  bodyClass="individuals-page"
  showCta={false}
  includeMainJs={true}
  extraModuleScripts={[]}
  hideUntilLoad={false}
>
  <div slot="head" style="display:contents">
    <link rel="preload" as="image" href={heroSlides[0].src} type="image/webp" />
    <style is:global>
      .individuals-page .container {
        max-width: 1280px;
        padding-left: clamp(1.25rem, 3vw, 2rem);
        padding-right: clamp(1.25rem, 3vw, 2rem);
      }
      .individuals-page .hero {
        min-height: 0;
        padding-top: 9rem;
      }
      .individuals-page .hero-container { max-width: 960px; }
      .individuals-page .hero-content { gap: 1.75rem; }
      .individuals-page .badge {
        background: rgba(255,255,255,0.06);
        border-color: rgba(255,255,255,0.12);
        color: #ecfdf5;
      }
      .individuals-page .hero-subtitle { max-width: 52rem; }
      .individuals-page .hero-cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
      }
      .individuals-page .hero-secondary-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      .individuals-hero-stage {
        width: min(100%, 440px);
        padding-top: clamp(4rem, 8vw, 6rem);
        padding-bottom: 4rem;
      }
      .individuals-hero-phone {
        width: min(100%, 420px);
        margin: 0 auto;
      }
      .demo-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4rem;
        padding: 2rem 0;
        width: 100%;
      }
      @media (max-width: 800px) { .demo-wrapper { flex-direction: column-reverse; gap: 2rem; } }

      .demo-phone-card { width: min(100%, 340px); flex-shrink: 0; }
      .demo-phone {
        position: relative;
        width: 100%;
        aspect-ratio: 9 / 19.5;
        background-color: #111827;
        border-radius: 44px;
        box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.8), inset 0 0 1px 1px rgba(255,255,255,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
      }
      .demo-front-cam {
        position: absolute;
        width: 8px;
        height: 8px;
        background: #1f2937;
        border-radius: 50%;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
      }
      .demo-screen {
        width: 100%;
        height: 100%;
        border-radius: 34px;
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
        background-color: #000;
        transition: background-image 0.4s ease;
        cursor: pointer;
        position: relative;
        z-index: 1;
        overflow: hidden;
      }
      .demo-steps { display: flex; flex-direction: column; gap: 1.5rem; }
      .demo-step { display: flex; align-items: center; gap: 16px; opacity: 0.35; transition: all 0.4s ease; cursor: pointer; }
      .demo-arrow {
        width: 0;
        height: 0;
        border-top: 7px solid transparent;
        border-bottom: 7px solid transparent;
        border-right: 10px solid #4b5563;
        transition: all 0.3s ease;
      }
      .demo-step-card {
        display: flex;
        align-items: center;
        background: rgba(255,255,255,0.03);
        padding: 1.25rem 2rem;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.08);
        min-width: 240px;
        backdrop-filter: blur(20px);
      }
      .demo-step-badge {
        width: 36px;
        height: 32px;
        background: rgba(255,255,255,0.1);
        color: #9ca3af;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-right: 16px;
        font-size: 16px;
      }
      .demo-step-text h4 { margin: 0; font-size: 17px; color: white; }
      .demo-step-text p { margin: 0; font-size: 14px; color: #9ca3af; }
      .demo-step.active { opacity: 1; }
      .demo-step.active .demo-arrow { border-right-color: #10b981; animation: demo-bounce 1.2s infinite; }
      .demo-step.active .demo-step-card { border-color: #10b981; background: rgba(16, 185, 129, 0.12); box-shadow: 0 0 30px rgba(16, 185, 129, 0.15); }
      .demo-step.active .demo-step-badge { background: #10b981; color: #fff; }
      .demo-step.completed { opacity: 1; }
      .demo-step.completed .demo-step-badge { background: #059669; color: white; }
      .demo-step.completed .demo-step-text h4 { color: #34d399; }
      @keyframes demo-bounce { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(-8px); } }

      .demo-hotspot {
        position: absolute;
        width: 64px;
        height: 64px;
        background: rgba(52, 211, 153, 0.2);
        border: 3px solid #10b981;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none;
        z-index: 10;
        animation: demo-pulse 1.5s infinite;
        transition: all 0.4s ease;
      }
      .demo-hotspot.hidden { opacity: 0; visibility: hidden; }
      @keyframes demo-pulse {
        0% { transform: translate(-50%, -50%) scale(0.9); box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5); }
        70% { transform: translate(-50%, -50%) scale(1.1); box-shadow: 0 0 0 12px rgba(52, 211, 153, 0); }
        100% { transform: translate(-50%, -50%) scale(0.9); }
      }

      .card-fan-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 720px;
        width: 100%;
        position: relative;
        margin: 2rem 0;
      }
      .fan-card {
        height: 560px;
        width: 300px;
        background-color: #111;
        border-radius: 36px;
        border: 1px solid #333;
        position: absolute;
        transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        transform-origin: bottom center;
        overflow: hidden;
        box-shadow: 0 40px 80px rgba(0,0,0,0.6);
        display: flex;
        flex-direction: column;
      }
      .fan-card img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: #000;
        opacity: 0.95;
        transition: opacity 0.4s ease;
      }
      .card-fan-container:hover .fan-card img { opacity: 1; }
      .card-fan-container .fan-card:nth-child(1) { transform: rotate(-24deg) translateX(-140px); z-index: 1; }
      .card-fan-container .fan-card:nth-child(2) { transform: rotate(-12deg) translateX(-70px); z-index: 2; }
      .card-fan-container .fan-card:nth-child(3) { transform: rotate(0deg); z-index: 3; }
      .card-fan-container .fan-card:nth-child(4) { transform: rotate(12deg) translateX(70px); z-index: 2; }
      .card-fan-container .fan-card:nth-child(5) { transform: rotate(24deg) translateX(140px); z-index: 1; }
      .card-fan-container:hover .fan-card:nth-child(1) { transform: rotate(-35deg) translateX(-320px) translateY(-50px); }
      .card-fan-container:hover .fan-card:nth-child(2) { transform: rotate(-18deg) translateX(-160px) translateY(-25px); }
      .card-fan-container:hover .fan-card:nth-child(3) { transform: rotate(0deg) translateY(-40px) scale(1.1); }
      .card-fan-container:hover .fan-card:nth-child(4) { transform: rotate(18deg) translateX(160px) translateY(-25px); }
      .card-fan-container:hover .fan-card:nth-child(5) { transform: rotate(35deg) translateX(320px) translateY(-50px); }
      .fan-card:hover { border-color: #10b981 !important; z-index: 10 !important; box-shadow: 0 50px 120px rgba(16, 185, 129, 0.4); }

      .showcase-phone.glass {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.12);
        box-shadow: 0 40px 100px -20px rgba(0,0,0,0.7);
        border-radius: 44px;
        padding: 12px;
      }
      .individuals-section { padding: 10rem 0; }
      .individuals-showcase-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.2fr);
        gap: clamp(3rem, 7vw, 8rem);
        align-items: center;
      }
      .section-heading {
        font-size: clamp(2.4rem, 5vw, 4rem);
        color: white;
        margin-bottom: 2rem;
        font-weight: 900;
        letter-spacing: -0.02em;
      }
      .section-copy {
        color: #9ca3af;
        font-size: clamp(1.125rem, 2vw, 1.45rem);
        line-height: 1.75;
        margin-bottom: 3rem;
      }
      .section-list {
        list-style: none;
        padding: 0;
        color: #d1d5db;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }
      .section-list li {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        font-size: clamp(1rem, 1.7vw, 1.2rem);
        line-height: 1.55;
      }
      .section-list svg { flex-shrink: 0; margin-top: 0.1rem; }
      .app-carousel .hero-carousel-slide img {
        object-fit: contain !important;
        width: 100% !important;
        height: auto !important;
        max-height: 100% !important;
        background: #000;
        border-radius: 34px;
      }
      .individuals-page .app-carousel .hero-carousel-arrow {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,0.92);
        border-color: rgba(16, 185, 129, 0.65);
        color: #065f46;
        font-size: 1.5rem;
      }
      .individuals-page .app-carousel .hero-carousel-arrow:hover {
        background: #10b981;
        color: #fff;
      }
      .individuals-page .app-carousel .hero-carousel-prev {
        left: 0.6rem;
      }
      .individuals-page .app-carousel .hero-carousel-next {
        right: 0.6rem;
      }

      .text-gradient {
        background: linear-gradient(90deg, #34d399, #10b981);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .hero-bg-glow { background: radial-gradient(circle at 50% -20%, rgba(16, 185, 129, 0.15) 0%, transparent 50%); }
      .pillars-section { background: #050a06; padding: 10rem 0; }
      .pillars-title { text-align: center; margin-bottom: 6rem; font-size: 3.5rem; font-weight: 800; color: white; letter-spacing: -0.03em; }
      .pillars-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 3rem; }
      .pillar-card { background: rgba(255,255,255,0.02); padding: 4rem 3rem; border-radius: 40px; border: 1px solid rgba(255,255,255,0.06); transition: all 0.4s ease; }
      .pillar-card:hover { border-color: rgba(16, 185, 129, 0.4); background: rgba(255,255,255,0.04); transform: translateY(-10px); }
      .pillar-label { font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #10b981; letter-spacing: 0.2em; display: block; margin-bottom: 1.5rem; }
      .pillar-card h3 { color: white; font-size: 2rem; margin-bottom: 1.5rem; font-weight: 800; line-height: 1.2; }
      .pillar-card p { color: #9ca3af; line-height: 1.8; font-size: 1.15rem; }
      .pricing-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(20px);
        border-radius: 40px;
        padding: 4rem;
      }
      .pricing-title {
        font-size: clamp(2.75rem, 6vw, 4.5rem);
        color: white;
        font-weight: 900;
        margin-bottom: 1.5rem;
        letter-spacing: -0.04em;
      }
      .pricing-subtitle {
        color: #9ca3af;
        font-size: clamp(1.125rem, 2.4vw, 1.5rem);
        font-weight: 400;
      }
      .pricing-copy {
        color: #d1d5db;
        line-height: 1.8;
        margin-bottom: 4rem;
        font-size: 1.2rem;
      }
      .pricing-feature-list {
        list-style: none;
        padding: 0;
        color: #d1d5db;
        display: flex;
        flex-direction: column;
        gap: 1.35rem;
        margin-bottom: 4rem;
      }
      .pricing-feature-list li {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 1.15rem;
      }
      .pricing-feature-list svg { flex-shrink: 0; }
      .pricing-cta {
        background: #10b981;
        color: white;
        padding: 1.4rem;
        border-radius: 24px;
        font-weight: 900;
        text-decoration: none;
        text-align: center;
        display: block;
        font-size: 1.35rem;
        box-shadow: 0 25px 50px -10px rgba(16, 185, 129, 0.6);
        transition: transform 0.3s ease;
      }
      .pricing-cta:hover { transform: translateY(-2px); }
      .individual-card { position: relative; }
      .individual-badge {
        position: absolute;
        top: -18px;
        left: 50%;
        transform: translateX(-50%);
        background: #020c07;
        color: #10b981;
        border: 2px solid #10b981;
        font-size: 0.85rem;
        font-weight: 800;
        padding: 0.4rem 1.5rem;
        border-radius: 100px;
        white-space: nowrap;
        letter-spacing: 0.05em;
      }
      .philosophy-copy {
        color:#34d399;
        font-weight:900;
        font-size: clamp(1.6rem, 4vw, 2.25rem);
        margin: 0;
        letter-spacing: -0.02em;
      }
      .individuals-cta-box {
        padding: clamp(4rem, 10vw, 8rem) 2rem;
        border-radius: 48px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.01);
      }
      .individuals-cta-title {
        font-size: clamp(2.6rem, 6vw, 4.5rem);
        color: white;
        font-weight: 900;
        margin-bottom: 2rem;
        letter-spacing: -0.04em;
      }
      .individuals-cta-copy {
        color: #9ca3af;
        font-size: clamp(1.125rem, 2.5vw, 1.5rem);
        max-width: 48rem;
        margin: 0 auto 3.5rem;
        line-height: 1.65;
      }
      .individuals-cta-button {
        background: #10b981;
        color: white;
        padding: 1.4rem 3.5rem;
        border-radius: 24px;
        font-weight: 900;
        text-decoration: none;
        font-size: 1.3rem;
        display: inline-block;
        box-shadow: 0 30px 60px -15px rgba(16, 185, 129, 0.6);
      }
      .reveal { opacity: 0; transform: translateY(30px); transition: all 1s cubic-bezier(0.16, 1, 0.3, 1); }
      .reveal.revealed { opacity: 1; transform: translateY(0); }

      @media (max-width: 980px) {
        .individuals-showcase-grid,
        .showcase-grid {
          grid-template-columns: 1fr !important;
          gap: 4rem !important;
          direction: ltr !important;
        }
        .demo-steps {
          width: 100%;
          max-width: 34rem;
        }
        .demo-step-card {
          min-width: 0;
          width: 100%;
        }
      }

      @media (max-width: 700px) {
        .individuals-page .hero {
          padding-top: 7.5rem;
          padding-bottom: 4.5rem !important;
        }
        .individuals-page .hero-cta {
          width: 100%;
        }
        .individuals-page .hero-cta .btn {
          width: 100%;
          justify-content: center;
        }
        .individuals-hero-stage {
          width: min(100%, 420px);
          padding-top: 3rem;
          padding-bottom: 2rem;
        }
        .individuals-hero-phone {
          width: min(92vw, 390px);
        }
        .individuals-page .app-carousel .hero-carousel-arrow {
          width: 46px;
          height: 46px;
          font-size: 1.35rem;
        }
        .demo-phone-card {
          width: min(92vw, 360px);
        }
        .demo-step {
          gap: 0.75rem;
          align-items: stretch;
        }
        .demo-step-card {
          padding: 1rem 1.1rem;
        }
        .demo-step-badge {
          margin-right: 0.9rem;
        }
        .demo-arrow {
          display: none;
        }
        .card-fan-container {
          height: auto;
          min-height: 0;
          flex-direction: column;
          gap: 1.5rem;
          position: static;
        }
        .fan-card,
        .card-fan-container .fan-card:nth-child(n),
        .card-fan-container:hover .fan-card:nth-child(n) {
          position: static;
          transform: none;
          width: min(320px, 100%);
          height: auto;
          aspect-ratio: 9 / 19.5;
        }
        .pillars-grid { grid-template-columns: 1fr; }
        .pillars-title {
          font-size: clamp(2.2rem, 10vw, 3rem);
          margin-bottom: 3rem;
        }
        .pillar-card {
          padding: 2.25rem 1.5rem;
          border-radius: 28px;
        }
        .pillar-card h3 {
          font-size: 1.6rem;
        }
        .pricing-card { padding: 3rem 2rem; }
        .individuals-section { padding: 7rem 0; }
        .individuals-cta-box { border-radius: 32px; }
        .individuals-cta-button {
          width: 100%;
          padding-left: 1.5rem;
          padding-right: 1.5rem;
        }
      }
    </style>
  </div>

  <section class="hero" style="background: #020c07; padding: 10rem 0 6rem;">
    <div class="hero-bg-glow"></div>
    <div class="container hero-container">
      <div class="hero-content" style="text-align: center;">
        <div class="badge reveal">🌿 For individuals who smoke cannabis</div>
        <h1 class="reveal" style="font-size: clamp(3rem, 7.5vw, 5.5rem); font-weight: 900; line-height: 1.02; margin-top: 2.5rem; letter-spacing: -0.04em;">
          Finally know <span class="text-gradient">exactly how much you smoke</span> — and why.
        </h1>
        <p class="hero-subtitle reveal" style="font-size: 1.6rem; color: #9ca3af; max-width: 850px; margin: 2.5rem auto; line-height: 1.6; font-weight: 400;">
          Three taps to log a session. See your frequency, timing, mood, and triggers build into a real picture over days and weeks. No guesswork. No counselor needed.
        </p>
        <div class="hero-cta reveal" style="margin-top: 3.5rem;">
          <a href="/individual-signup.html" class="btn btn-primary btn-large" style="background: #10b981; color: white; padding: 1.5rem 3.5rem; border-radius: 18px; font-weight: 800; text-decoration: none; display: inline-block; font-size: 1.3rem; box-shadow: 0 20px 40px -10px rgba(16, 185, 129, 0.6);">Start Free — No Card Needed</a>
          <div class="hero-secondary-link">
            <a href="#how-it-works-individual" class="btn btn-secondary btn-large" style="color: white; text-decoration: none; font-size: 1.2rem; border-bottom: 2px solid rgba(255,255,255,0.2); padding-bottom: 4px; font-weight: 600; opacity: 0.8; transition: opacity 0.3s;">See How It Works</a>
          </div>
        </div>
      </div>
    </div>
    <div class="container reveal individuals-hero-stage">
      <div class="showcase-phone glass individuals-hero-phone">
        <div class="hero-carousel app-carousel" id="individuals-hero-carousel">
          <button class="hero-carousel-arrow hero-carousel-prev" type="button" aria-label="Previous slide">&#8249;</button>
          <button class="hero-carousel-arrow hero-carousel-next" type="button" aria-label="Next slide">&#8250;</button>
          <div class="hero-carousel-track">
            {heroSlides.map((slide, index) => (
              <div class:list={['hero-carousel-slide', { active: index === 0 }]}>
                <img
                  src={slide.src}
                  alt={slide.alt}
                  width={slide.width}
                  height={slide.height}
                  fetchpriority={slide.priority ? 'high' : undefined}
                  loading={slide.priority ? undefined : 'lazy'}
                />
              </div>
            ))}
          </div>
          <div class="hero-carousel-dots" style="margin-top: 2rem;">
            {heroSlides.map((_, index) => (
              <button
                type="button"
                class:list={['hero-carousel-dot', { active: index === 0 }]}
                aria-label={`Go to slide ${index + 1}`}
              ></button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pillars-section">
    <div class="container">
