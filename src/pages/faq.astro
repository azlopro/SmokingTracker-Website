---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageSeo } from '../lib/pageSeo';

const { title, description, ogTitle, ogDescription, ogImage } = getPageSeo('faq');
const faqSections = [
  {
    category: 'Getting Started',
    categoryKey: 'faq.cat1',
    items: [
      ['faq.q1', 'How quickly can we get started?', 'faq.a1', "Most treatment centers are up and running within one working day. Once you sign up, you'll receive a setup link by email. From there, you can invite your first client within minutes."],
      ['faq.q2', 'Do clients need to download an app?', 'faq.a2', 'No. SmokingTracker runs entirely in the browser. Clients can access it from any smartphone, tablet, or computer — no app store required.'],
      ['faq.q17', 'How do clients receive access?', 'faq.a17', "You generate an invitation link from your dashboard and share it however you prefer — email, SMS, WhatsApp, or hand it over in session. The client clicks the link, sets a PIN, and is ready to log. No account creation, no app store, no IT involvement."],
      ['faq.q18', 'Is there any training required?', 'faq.a18', "No mandatory training. Most clinicians are comfortable with the dashboard after a single session. We provide a getting-started guide and respond to questions by email. The client-side interface is designed to be self-explanatory — clients typically log their first session without any instruction."],
      ['faq.q19', 'Can individual practitioners sign up, or is it only for treatment centers?', 'faq.a19', "Both. Individual practitioners working with cannabis use disorder clients can sign up for a single-clinician account. The pilot is open to any professional in the field, whether you're at a large center or in private practice."],
    ],
  },
  {
    category: 'Pricing & Billing',
    categoryKey: 'faq.cat2',
    items: [
      ['faq.q3', 'What does it cost?', 'faq.a3', 'SmokingTracker is currently free for treatment centers during the pilot period, which runs until October 2026. Future paid pricing will be communicated clearly before it takes effect.'],
      ['faq.q4', 'How is billing handled?', 'faq.a4', "There are currently no automatic charges. If paid plans launch after the pilot period, billing details and timing will be communicated clearly in advance."],
      ['faq.q9', 'Can we stop using it whenever we want?', 'faq.a9', 'Yes. There are no long-term contracts during the pilot period, and you can stop at any time.'],
    ],
  },
  {
    category: 'Privacy & Security',
    categoryKey: 'faq.cat3',
    items: [
      ['faq.q5', "Who owns the client's data?", 'faq.a5', 'The client does. They choose exactly what to share through granular consent toggles and can withdraw consent or request deletion at any time.'],
      ['faq.q6', 'Is SmokingTracker GDPR-compliant?', 'faq.a6', 'Yes. SmokingTracker is built Privacy by Design. We act as a data processor under your controller role. A full Data Processing Agreement (DPA) is included with all plans. All data is stored in the EU.'],
      ['faq.q10', 'Where is the data stored?', 'faq.a10', 'All data is stored on EU-based servers. We never transfer data outside the EU/EEA.'],
    ],
  },
  {
    category: 'Technical',
    categoryKey: 'faq.cat4',
    items: [
      ['faq.q7', 'Does it integrate with my EHR system?', 'faq.a7', 'Not via a direct API connection — but you can export a print-ready report and attach it as a PDF to case files in Epic, Kipu, Netsmart, or any EHR system that accepts PDF uploads.'],
      ['faq.q8', 'What browsers and devices are supported?', 'faq.a8', 'All modern browsers (Chrome, Firefox, Safari, Edge) on smartphones, tablets, and computers. No installation required for clients or staff.'],
      ['faq.q20', 'How do I generate a PDF report for a client?', 'faq.a20', "Open the client's profile on the dashboard, scroll to the Report section, and click Export PDF. The report includes usage trend charts, session annotations, trigger frequency rankings, and mood data — formatted for EHR attachment or clinical supervision. It prints cleanly from any browser."],
      ['faq.q21', 'Can multiple clinicians share access to the same client?', 'faq.a21', 'Currently each client is linked to one clinician account. If your center has multiple staff members, each can have their own account and client list. Multi-practitioner caseload sharing — where two clinicians co-manage the same client — is on the product roadmap.'],
    ],
  },
  {
    category: 'For Clinicians',
    categoryKey: 'faq.cat5',
    items: [
      ['faq.q11', 'What does the app track — cigarettes or cannabis?', 'faq.a11', 'Primarily cannabis. The app supports joints/spliffs, dry herb vaporizer, vape pen, edible, concentrate, blunts, and pipe/bong — the client chooses their method during onboarding. The name SmokingTracker is historical; the platform is designed for cannabis use disorder treatment.'],
      ['faq.q12', 'What exactly triggers green, yellow, and red?', 'faq.a12', 'The traffic light is based on engagement — how recently the client logged a session. Green: logged within the last 2 days. Yellow: last log was 2–7 days ago. Red: no log in 7+ days, or never logged. It reflects engagement with the app, not the quantity consumed. Disengagement — not logging — is often the first observable sign of a client pulling back from treatment. It gives you an early signal to reach out before the next scheduled session.'],
      ['faq.q13', 'What happens when a client withdraws consent?', 'faq.a13', 'Their data is hidden from you immediately — not deleted. You can still see their alias, traffic light status, and last activity timestamp. The client can reactivate consent at any time, and their full history will be visible again.'],
      ['faq.q14', 'What happens in a crisis situation?', 'faq.a14', "You configure trigger alerts per client by choosing from three types: inactivity threshold (e.g. no log in 5 days), consecutive use streak, or a craving spike (e.g. urge frequency up 50% week-over-week). Each trigger type has adjustable parameters. When a rule fires, you receive a notification via app, email, or SMS. SmokingTracker does not replace crisis intervention — it gives you the early signals to act before things escalate."],
      ['faq.q15', 'Who is the data controller?', 'faq.a15', 'Azlo is the data controller for the SmokingTracker platform. A Data Processing Agreement (DPA) is included with all plans and sets out the responsibilities of both parties. Contact us at support@smokingtracker.com with any data protection questions.'],
      ['faq.q16', 'What about clients without a smartphone?', 'faq.a16', 'SmokingTracker is a web app — no download required. It runs in any modern browser on any device: smartphone, tablet, or computer. Clients only need internet access.'],
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath="/faq.html"
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  twitterImage={ogImage}
  activeNav={""}
  navVariant={"marketing"}
  footerVariant={"full"}
  bodyClass={"light-theme"}
  showCta={false}
  includeMainJs={true}
  extraModuleScripts={[]}
  hideUntilLoad={true}
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqSections.flatMap(section =>
      section.items.map(([, question, , answer]) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      }))
    ),
  })} />
  <main>
    <section class="simple-page-hero">
      <div class="simple-page-hero-inner">
        <div class="simple-page-kicker">Common Questions</div>
        <h1>Frequently Asked Questions</h1>
        <p>Questions from treatment centers and clinicians, answered.</p>
      </div>
    </section>

    <section class="features-section faq-section">
      <div class="container">
        <div class="faq-list fade-in-up">
          {
            faqSections.map((section) => (
              <>
                <p class="faq-category" data-i18n={section.categoryKey}>{section.category}</p>
                {section.items.map(([questionKey, question, answerKey, answer]) => (
                  <details class="faq-item glass">
                    <summary>
                      <span data-i18n={questionKey}>{question}</span>
                      <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </summary>
                    <div class="faq-body" data-i18n={answerKey}>{answer}</div>
                  </details>
                ))}
              </>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .simple-page-hero {
    background: var(--green-pale);
    padding: 4rem 2.5rem 3rem;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .simple-page-hero-inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .simple-page-kicker {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--green);
    margin-bottom: 0.75rem;
  }

  .simple-page-hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.4px;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .simple-page-hero p {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
    max-width: 560px;
    margin: 0 auto;
  }

  .faq-section {
    padding-top: 0;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 780px;
    margin: 0 auto;
  }

  .faq-item {
    border-radius: 16px;
    overflow: hidden;
  }

  .faq-item summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    font-weight: 600;
    font-size: 1rem;
    user-select: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    transition: transform 0.25s ease;
    color: var(--color-primary, #4ade80);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-body {
    padding: 0 1.5rem 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .faq-category {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary, #4ade80);
    margin: 2.5rem 0 1rem;
  }

  .faq-category:first-child {
    margin-top: 0;
  }
</style>
